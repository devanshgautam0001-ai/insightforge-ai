# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Cloud SQL Connection Variables (Provided at runtime)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""

# Cloud SQL Administration (Required for schema migration)
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Enterprise Contact / Demo Request Email Configuration
# Choose one of the following methods for sending real emails:
# 1. Resend API (Recommended)
RESEND_API_KEY=""

# 2. SendGrid API
SENDGRID_API_KEY=""

# 3. Custom SMTP Server
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# 4. Gmail SMTP
GMAIL_USER=""
GMAIL_PASS=""

